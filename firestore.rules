rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admin helper ─────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vittorem19@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ─── Licenses collection ──────────────────────────────────────────
    // Admin can read/write all licenses.
    // Each user can read their own license (to check authorization status).
    // Users can create their own license doc on first login (isAuthorized must be false).
    match /licenses/{licenseId} {
      allow read, write: if isAdmin();

      allow read: if request.auth != null
        && request.auth.uid == licenseId
        && request.auth.token.email_verified == true;

      // Allow users to create their own license (first-time registration)
      allow create: if request.auth != null
        && request.auth.uid == licenseId
        && request.auth.token.email_verified == true
        && resource == null
        && request.resource.data.isAuthorized == false;
    }

    // ─── Per-user data ────────────────────────────────────────────────
    match /users/{userId}/{document=**} {
      // Require the user to be authenticated AND have a verified email.
      // Google accounts always have emailVerified = true.
      // Email/password accounts must complete verification before accessing data.
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }
  }
}
